{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-session-runner.invalid/src/internal/mailbox/schemas/v1/event.schema.json",
  "title": "Remote Session Runner v1 mailbox command event",
  "type": "object",
  "properties": {
    "command_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "type": { "type": "string", "enum": ["command_queued", "command_started", "stdout", "stderr", "output_truncated", "command_succeeded", "command_failed", "command_cancelled", "command_timed_out", "command_rejected", "command_lost"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "ordinal": { "type": "integer", "minimum": 1 },
    "encoding": { "type": "string", "enum": ["utf8", "base64"] },
    "text": { "type": "string" },
    "data_base64": { "type": "string", "maxLength": 21848, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
    "byte_count": { "type": "integer", "minimum": 1, "maximum": 16384 },
    "exit_code": { "type": "integer" }
  },
  "required": ["command_id", "sequence", "type", "timestamp"],
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "type": { "const": "command_queued" } }, "required": ["type"] }, "then": { "properties": { "sequence": { "const": 1 } } } },
    {
      "if": { "properties": { "type": { "enum": ["stdout", "stderr"] } }, "required": ["type"] },
      "then": {
        "required": ["encoding", "byte_count"],
        "oneOf": [
          { "properties": { "encoding": { "const": "utf8" } }, "required": ["text"], "not": { "required": ["data_base64"] } },
          { "properties": { "encoding": { "const": "base64" } }, "required": ["data_base64"], "not": { "required": ["text"] } }
        ]
      },
      "else": {
        "not": { "anyOf": [{ "required": ["encoding"] }, { "required": ["text"] }, { "required": ["data_base64"] }, { "required": ["byte_count"] }] }
      }
    }
  ]
}
